{
  "name": "megapot-v2-public",
  "version": "1.0.0",
  "main": "index.js",
  "repository": "git@github.com:coordinationlabs/megapot-v2-public.git",
  "license": "MIT",
  "scripts": {
    "build": "yarn clean && yarn compile",
    "chain": "npx hardhat node",
    "clean": "rm -f coverage.json; rm -rf .coverage_cache; rm -rf .coverage_contracts; rm -rf cache; rm -rf coverage; rm -rf typechain; rm -rf artifacts; rm -rf dist",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:clean": "yarn build && yarn test",
    "test:fast": "NO_COMPILE=true TS_NODE_TRANSPILE_ONLY=1 yarn test --no-compile",
    "coverage": "node --max-old-space-size=4096 node_modules/.bin/hardhat coverage",
    "abigen": "npx hardhat abigen"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.1.0",
    "@nomicfoundation/hardhat-ethers": "3.1.0",
    "@nomicfoundation/hardhat-ignition": "0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "1.1.0",
    "@nomicfoundation/hardhat-toolbox": "6.1.0",
    "@nomicfoundation/hardhat-verify": "2.1.1",
    "@nomicfoundation/ignition-core": "0.15.15",
    "@typechain/ethers-v6": "0.5.1",
    "@typechain/hardhat": "9.1.0",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "24.2.1",
    "chai": "4.5.0",
    "ethers": "6.15.0",
    "hardhat": "2.29.1",
    "hardhat-abigen": "1.1.4",
    "hardhat-gas-reporter": "2.3.0",
    "prettier": "3.6.2",
    "solidity-coverage": "0.8.16",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typechain": "8.3.2",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@pythnetwork/entropy-sdk-solidity": "2.0.0",
    "dotenv": "17.2.2",
    "solady": "0.1.24"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
